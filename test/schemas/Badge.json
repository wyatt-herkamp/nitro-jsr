{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectConfig",
  "type": "object",
  "properties": {
    "badge_settings": {
      "title": "Badge Settings",
      "$ref": "#/$defs/BadgeSettings",
      "default": {
        "style": "flat",
        "label_color": "#555",
        "color": "#33B5E5"
      }
    },
    "require_semver": {
      "description": "Whether to require a semver version for releases",
      "type": "boolean",
      "default": false
    }
  },
  "$defs": {
    "BadgeSettings": {
      "type": "object",
      "properties": {
        "style": {
          "$ref": "#/$defs/BadgeStyle",
          "default": "flat"
        },
        "label_color": {
          "type": "string",
          "default": "#555"
        },
        "color": {
          "type": "string",
          "default": "#33B5E5"
        }
      }
    },
    "BadgeStyle": {
      "type": "string",
      "enum": ["flat", "plastic", "flatsquare"]
    }
  }
}
